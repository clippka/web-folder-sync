# Copy to .env. Contains no secrets: the administrator password is a mounted file.
FOLDERSYNC_VERSION=0.1.0
FOLDERSYNC_PORT=8080
FOLDERSYNC_ADMIN_USERNAME=admin
# Create the file yourself (12+ characters), e.g.  mkdir secrets && openssl rand -base64 24 > secrets/admin_password.txt
FOLDERSYNC_ADMIN_PASSWORD_FILE=./secrets/admin_password.txt
# Default per-file limit in bytes (100 MiB).
FOLDERSYNC_MAX_FILE_SIZE_BYTES=104857600
